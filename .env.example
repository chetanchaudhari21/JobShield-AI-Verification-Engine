# ==============================================================================
# JobShield AI - Environment Configuration Template
# Copy this file to `.env` in the root or backend directory for local development.
# Do NOT commit actual secrets, passwords, or production credentials to Git.
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME=JobShield AI API

# Database Connection (PostgreSQL 16/18 with psycopg 3 driver)
# Local native development:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobshield_db
# Docker Compose development:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/jobshield_db

# Docker Compose Service Ports & Database Credentials (Defaults for local dev)
POSTGRES_DB=jobshield_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins (comma-separated list of origins permitted to call the API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Explicit Trusted Chrome Extension IDs (comma-separated list of exact extension IDs)
CHROME_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyz123456

# Authentication & JWT Configuration
# MUST be set to a cryptographically random string (min 32 bytes) in production!
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (set AUTH_COOKIE_SECURE=True in production over HTTPS)
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_HTTPONLY=True

# Moderator & Community Security
COMMUNITY_SALT=jobshield-community-salt-change-in-production
MODERATOR_SECRET_KEY=jobshield-moderator-secret-key-change-in-production

# Machine Learning & OCR Paths
ML_MODEL_ARTIFACT_PATH=ml/artifacts/jobshield_fraud_detector_v1.1.0.joblib
# Native Windows default:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Docker / Linux default:
TESSERACT_CMD=/usr/bin/tesseract
